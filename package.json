{
  "name": "epam-cypress-bdd-tasks",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "test:chrome": "cypress run --browser chrome",
    "test:firefox": "cypress run --browser firefox",
    "test:edge": "cypress run --browser edge",
    "test:all-browsers": "npm run test:chrome && npm run test:firefox && npm run test:edge",
    "report:merge": "mochawesome-merge cypress/reports/mochawesome/*.json > cypress/reports/merged-report.json",
    "report:generate": "marge cypress/reports/merged-report.json -f report -o cypress/reports/mochawesome",
    "report": "npm run report:merge && npm run report:generate",
    "test:report": "npm test && npm run report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoloshynVolodymyr/epam-cypress-bdd-tasks.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/VoloshynVolodymyr/epam-cypress-bdd-tasks/issues"
  },
  "homepage": "https://github.com/VoloshynVolodymyr/epam-cypress-bdd-tasks#readme",
  "devDependencies": {
    "cypress": "^15.20.1",
    "mochawesome": "^8.0.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "typescript": "^7.0.2"
  }
}
